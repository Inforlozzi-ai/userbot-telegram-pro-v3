# Domínio / HTTPS
DOMAIN=painel.seudominio.com
LETSENCRYPT_EMAIL=admin@seudominio.com

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_AQUI
POSTGRES_DB=userbot_saas
DATABASE_URL=postgresql://postgres:TROQUE_AQUI@postgres:5432/userbot_saas

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Autenticação
JWT_SECRET=GERE_UMA_CHAVE_FORTE
CRYPTO_KEY=GERE_UMA_CHAVE_FORTE

# Docker / Traefik
DOCKER_IMAGE=inforlozzi/userbot-v3:latest
TRAEFIK_NETWORK=minha_rede

# Asaas (opcional até ativar billing)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PLAN_STARTER=
ASAAS_PLAN_PRO=
ASAAS_PLAN_AGENCY=

# Notificações Telegram (opcional)
NOTIFY_BOT_TOKEN=

# Next.js
NEXTAUTH_URL=https://painel.seudominio.com
NEXTAUTH_SECRET=GERE_UMA_CHAVE_FORTE
NEXT_PUBLIC_API_URL=https://painel.seudominio.com/api
INTERNAL_API_URL=http://api:3001
NEXT_PUBLIC_APP_URL=https://painel.seudominio.com
